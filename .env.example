# Sidekit Frontend Environment Variables
# Only public configuration belongs here. Never put API keys or database URIs in VITE_* variables:
# they are embedded into the browser bundle.
#
# VITE_API_URL: Backend API base URL used in production builds (e.g. Vercel).
# Leave unset in local dev — "/api" is proxied by Vite to http://localhost:4000.
# VITE_API_URL=https://your-backend.onrender.com/api
#
# VITE_USE_MOCK: Set to "true" to use browser localStorage (no backend needed).
# VITE_USE_MOCK=true
